{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-worklog/event-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entry_id", "revision_id", "parent_revision_ids", "revision_kind", "agent_id", "producer_instance_id", "source_namespace", "idempotency_key", "partition_date", "work_date", "timezone", "recorded_at", "source_refs", "model", "project_id", "task_id", "topic_id", "category", "subcategories", "technologies", "tags", "title", "summary", "actions", "status", "task_state_event", "outputs", "time", "milestone", "importance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "entry_id": {"$ref": "#/$defs/uuid"},
    "revision_id": {"$ref": "#/$defs/uuid"},
    "parent_revision_ids": {"type": "array", "uniqueItems": true, "maxItems": 16, "items": {"$ref": "#/$defs/uuid"}},
    "revision_kind": {"enum": ["create", "amend", "retract", "resolve"]},
    "revision_reason": {"type": "string", "minLength": 1, "maxLength": 500},
    "agent_id": {"$ref": "#/$defs/slug"},
    "producer_instance_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_namespace": {"$ref": "#/$defs/slug"},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 200},
    "partition_date": {"type": "string", "format": "date"},
    "work_date": {"type": "string", "format": "date"},
    "timezone": {"type": "string", "minLength": 1, "maxLength": 100},
    "recorded_at": {"type": "string", "format": "date-time"},
    "source_refs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["namespace", "source_id", "ref"], "properties": {"namespace": {"$ref": "#/$defs/slug"}, "source_id": {"type": "string", "minLength": 1, "maxLength": 200}, "ref": {"type": ["string", "null"], "maxLength": 500}}}},
    "model": {"type": ["string", "null"], "maxLength": 128},
    "project_id": {"$ref": "#/$defs/slug"},
    "task_id": {"anyOf": [{"$ref": "#/$defs/slug"}, {"type": "null"}]},
    "topic_id": {"anyOf": [{"$ref": "#/$defs/slug"}, {"type": "null"}]},
    "category": {"enum": ["implementation", "design", "review", "research", "operations", "learning", "other"]},
    "subcategories": {"$ref": "#/$defs/labels"},
    "technologies": {"$ref": "#/$defs/labels"},
    "tags": {"$ref": "#/$defs/labels"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "actions": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "status": {"enum": ["planned", "in_progress", "blocked", "completed", "cancelled"]},
    "task_state_event": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["state", "occurred_at", "source_ref"], "properties": {"state": {"enum": ["planned", "in_progress", "blocked", "completed", "cancelled"]}, "occurred_at": {"type": "string", "format": "date-time"}, "source_ref": {"type": "string", "minLength": 1, "maxLength": 500}}}]},
    "outputs": {"type": "array", "maxItems": 30, "items": {"type": "object", "additionalProperties": false, "required": ["name", "kind", "ref"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 200}, "kind": {"enum": ["file", "commit", "document", "decision", "other"]}, "ref": {"type": ["string", "null"], "maxLength": 500}}}},
    "time": {"type": "object", "additionalProperties": false, "required": ["activity_window", "duration_seconds", "duration_type", "evidence_ref", "allocation_method", "segments"], "properties": {"activity_window": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}}]}, "duration_seconds": {"type": ["integer", "null"], "minimum": 0}, "duration_type": {"enum": ["exact", "estimated", "unknown"]}, "evidence_ref": {"type": ["string", "null"], "maxLength": 500}, "allocation_method": {"enum": ["work_date", "measured_segments"]}, "segments": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["start", "end", "duration_seconds"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}, "duration_seconds": {"type": "integer", "minimum": 0}}}}}},
    "milestone": {"type": "boolean"},
    "importance": {"enum": ["low", "normal", "high"]},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9_-]*$"}}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "labels": {"type": "array", "uniqueItems": true, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 80}}
  }
}
