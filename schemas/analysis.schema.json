{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "analysis_key", "input_digest", "analysis_version", "status", "claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_key": {"type": "string", "minLength": 1},
    "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "analysis_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["available", "unavailable", "rejected"]},
    "claims": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["text", "source_entry_ids", "inference"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 2000}, "source_entry_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}, "inference": {"type": "boolean"}}}}
  }
}
