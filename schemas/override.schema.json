{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "override_id", "kind", "targets", "value", "reason", "source_ref", "recorded_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "override_id": {"type": "string", "format": "uuid"},
    "kind": {"enum": ["topic_alias", "task_identity", "exclude", "conflict_resolution"]},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "value": {"type": ["string", "null"], "maxLength": 128},
    "reason": {"type": "string", "minLength": 1, "maxLength": 500},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 500},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
